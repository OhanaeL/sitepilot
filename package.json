{
  "name": "sitepilot-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "typecheck": "bun run --filter './packages/*' --filter './examples/*' typecheck",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "bun test --conditions=@sitepilot/source",
    "dev:example": "bun run --filter sitepilot-example-vite-react dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@happy-dom/global-registrator": "20.14.5",
    "@types/bun": "^1.3.0",
    "happy-dom": "^20.14.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0"
  }
}
