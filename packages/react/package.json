{
  "name": "@sitepilot/react",
  "version": "0.1.0",
  "description": "React bindings and a drop-in chat widget for @sitepilot/core.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@sitepilot/core": "workspace:*",
    "react": ">=18"
  },
  "devDependencies": {
    "@sitepilot/core": "workspace:*",
    "@types/react": "^19.0.0",
    "react": "^19.0.0"
  },
  "repository": { "type": "git", "url": "https://github.com/OhanaeL/sitepilot", "directory": "packages/react" },
  "keywords": ["ai", "agent", "copilot", "react", "chat-widget"]
}
