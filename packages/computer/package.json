{
  "name": "@sitepilot/computer",
  "version": "0.1.0",
  "description": "Computer-use style plugin for @sitepilot/core: a privacy-preserving screenshot showing only opted-in elements, plus coordinate-based action batches.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@sitepilot/core": "workspace:*"
  },
  "devDependencies": {
    "@sitepilot/core": "workspace:*"
  },
  "repository": { "type": "git", "url": "https://github.com/OhanaeL/sitepilot", "directory": "packages/computer" },
  "keywords": ["ai", "agent", "computer-use", "screenshot", "copilot", "privacy"]
}
